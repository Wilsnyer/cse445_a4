<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="http://venus.sod.asu.edu/WSRepository/xml" elementFormDefault="qualified" attributeFormDefault="unqualified">
    <xs:element name="NationalParks" type="NationalParksType"/>
    <xs:complexType name="NationalParksType">
        <xs:sequence>
            <xs:element name="NationalPark" type="NationalParkDetails" minOccurs="1" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="NationalParkDetails">
        <xs:sequence>
            <xs:element name="Name" type="xs:string" minOccurs="1" maxOccurs="1"/>
            <xs:element name="Phone" type="PhoneType" minOccurs="1" maxOccurs="unbounded"/>
            <xs:element name="Address" type="AddressDetails" minOccurs="1" maxOccurs="1"/>
        </xs:sequence>
        <xs:attribute name="Rating" type="xs:string" use="optional"/>
    </xs:complexType>
    <xs:complexType name="AddressDetails">
        <xs:sequence>
            <xs:element name="Number" type="xs:string" minOccurs="1" maxOccurs="1"/>
            <xs:element name="Street" type="xs:string" minOccurs="1" maxOccurs="1"/>
            <xs:element name="City" type="xs:string" minOccurs="1" maxOccurs="1"/>
            <xs:element name="State" type="xs:string" minOccurs="1" maxOccurs="1"/>
            <xs:element name="Zip" type="xs:string" minOccurs="1" maxOccurs="1"/>
        </xs:sequence>
        <xs:attribute name="NearestAirport" type="xs:string" use="required"/>
    </xs:complexType>
</xs:schema>